# Environment variables consumed by deployments/multi-idp/docker-compose.yml.
#
# Copy to .env in the same directory before running `make dev STACK=multi-idp`.
# The .env file is git-ignored.
#
#   cp deployments/multi-idp/.env.example deployments/multi-idp/.env
#   # then edit the values below

# ─────────────────────────────────────────────────────────────────────
# Authentik secrets
# ─────────────────────────────────────────────────────────────────────

# Required. Used by Authentik to encrypt session cookies and signed
# data. Generate with: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=

# Required. Bearer token for Authentik → OAD SCIM provisioning.
# OAD reads the same value from OAD_SCIM_TOKEN_AUTHENTIK below.
# Generate with: openssl rand -hex 32
AUTHENTIK_OAD_SCIM_TOKEN=

# Required. Must equal AUTHENTIK_OAD_SCIM_TOKEN. Read by the OAD api
# container and registered in the SCIM tenant token registry as the
# token for the `authentik` provider.
OAD_SCIM_TOKEN_AUTHENTIK=

# ─────────────────────────────────────────────────────────────────────
# Authentik bootstrap (optional — defaults shown)
# ─────────────────────────────────────────────────────────────────────

# Initial admin password for the built-in akadmin user. Override only if
# you intend to log into the Authentik admin UI on http://localhost:9000.
AUTHENTIK_BOOTSTRAP_PASSWORD=akadmin

# Optional API token for akadmin. Leave empty unless you plan to script
# Authentik via its REST API from the host.
AUTHENTIK_BOOTSTRAP_TOKEN=

# Per-fixture-user passwords applied by the blueprint. Defaults match
# the user names so the demo is keyboard-friendly. Override for any
# environment where these values must not be predictable.
AUTHENTIK_BOOTSTRAP_USER_PW_ADMIN=admin
AUTHENTIK_BOOTSTRAP_USER_PW_EDITOR=editor
AUTHENTIK_BOOTSTRAP_USER_PW_VIEWER=viewer
AUTHENTIK_BOOTSTRAP_USER_PW_PDP=pdp
